# MinerU 配置
MINERU_OUTPUT_DIR=./temp/mineru_output

# 大模型配置 (Qwen)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
MODEL_NAME=qwen-plus

# 服务配置
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 文件上传配置
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./temp/uploads

# 阿里云 OSS 配置
OSS_ACCESS_KEY_ID=your_oss_access_key_id_here
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret_here
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your_bucket_name_here

# Gamma API 配置
GAMMA_API_KEY=your_gamma_api_key_here
